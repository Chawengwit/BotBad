{
  "name": "badminton-line-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "migrate:test": "DB_SCHEMA=bot_test node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test:db": "DB_SCHEMA=bot_test vitest run tests/db"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "next": "^16.3.5",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
